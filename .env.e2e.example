# Copy this file to .env.e2e and fill in real values. .env.e2e is gitignored —
# never commit real credentials. In GitHub Actions, these same names are set as
# repository secrets instead (see .github/workflows/e2e.yml).
#
# All FOUR accounts below must already exist and be fully set up (password
# already changed past the forced first-login change) — these tests log in with
# them, they don't create them. Create them once via the app or the bootstrap
# script, then reuse them for every test run.

# Which environment to test against. Use your live domain once the domain/DNS
# fix is live, or a Netlify deploy-preview URL to test a branch before merging.
E2E_BASE_URL=https://jebbidox.site

# A real, already-active Super Administrator account
E2E_SUPERADMIN_EMAIL=
E2E_SUPERADMIN_PASSWORD=

# A real, already-active Finance Officer account
E2E_FO_EMAIL=
E2E_FO_PASSWORD=

# A real, already-active Investor account (dedicated to testing — every test run
# submits a real deposit under this account, so don't use a real stakeholder's
# account for this)
E2E_INVESTOR_EMAIL=
E2E_INVESTOR_PASSWORD=
